# --- single camera -----------------------------------------------------------
TAPO_HOST=192.168.1.50
TAPO_PASSWORD=your-tapo-ACCOUNT-password

# The TP-Link account password you sign into the Tapo app with - NOT a camera
# account (battery models have no such screen) and NOT your Wi-Fi password.
TAPO_USER=admin

# Served at /<TAPO_NAME>.ts  (and /stream.ts when there is only one camera)
TAPO_NAME=stream

# HD or SD. SD costs the camera far less battery if you only need detection.
TAPO_QUALITY=HD

TAPO_INCLUDE_AUDIO=0

# Optional JSON passed to pytapo's Streamer as ff_args, for anything not modelled
# above. Example - transcode to H.264 at the bridge for H.265-shy clients:
# TAPO_FF_ARGS={"-c:v":"libx264"}

# --- several cameras ---------------------------------------------------------
# Set this INSTEAD of the TAPO_HOST/TAPO_PASSWORD pair above. Each entry is served
# at /<name>.ts
# TAPO_CAMERAS=[{"name":"front","host":"192.168.1.50","password":"…"},{"name":"yard","host":"192.168.1.51","password":"…","quality":"SD"}]

# --- server ------------------------------------------------------------------
BRIDGE_PORT=8080
BRIDGE_BIND=0.0.0.0
BRIDGE_LOG_LEVEL=INFO
